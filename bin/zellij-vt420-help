#!/usr/bin/env bash
# The LK401 keys of zellij's VT420 profile, shown by Help in a floating pane; any key closes it.
printf '\033[?25l'
cat <<'EOF'
 LK401 keys in zellij                                      any key closes

 F11      lock: all keys to the program until F11 again
 F12      pane mode            F17 F18  previous, next tab
 F13      tab mode             F19      new pane
 Do       session mode         F20      scroll mode
 Help     these keys           F6-F10, PF1-PF4: the program's

 F14, then  F11-F20  that key to the program (F11 is Escape)
            F6 F7    focus left, right    F8 new pane    F9 floating
            F10      fullscreen           F14 itself
            PF1-PF4  pane, tab, resize, scroll mode

 pane     n new  d down  r right  s stacked  x close  arrows focus
          f full  w float  e embed  z frames  c rename  m move  i pin
 tab      n new  x close  arrows switch  1-9 go to  Tab last  r rename
 scroll   arrows, Prev, Next  d u half page  s search  e edit
 session  d detach  w sessions  c config  l layouts  q quit
EOF
read -rsn1
